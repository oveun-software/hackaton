PORT=4317
DATA_DIR=./data
# Required hackathon route. Store the NVIDIA key in Nightshift > Providers.
AI_PROVIDER=meterless
# Nightshift must route this lane to a Nemotron model for our demo.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/deep
# Optional Zetaris Trino endpoint. Use a dedicated read-only user/view.
ZETARIS_URL=
ZETARIS_USER=
ZETARIS_TOKEN=
ZETARIS_TABLE=hackathon.recruiting.candidates
