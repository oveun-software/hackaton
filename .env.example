PORT=4317
DATA_DIR=./data
# Stable tenant boundary. One local TalentLens process serves exactly this organization.
TALENTLENS_ORG_ID=talentlens-local
# Required hackathon route. Store the NVIDIA key in Nightshift > Providers.
AI_PROVIDER=meterless
# Nightshift 1.2.1 advertises concrete model IDs alongside routing modes.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Zetaris Lightning REST. Use a separate, read-only API key per developer.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_TABLE=talentlens.candidates
# Set true only for the clearly fictional sources in examples/zetaris.
ZETARIS_SYNTHETIC=false
