{
  "name": "talentlens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multilingual CV discovery with verifiable AI recommendations",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check server/index.js && node --check public/app.js && node --check public/i18n.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "fflate": "^0.8.2",
    "saxes": "^6.0.0",
    "zod": "^4.1.12"
  }
}
